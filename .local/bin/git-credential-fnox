#!/usr/bin/env sh
# fnox-backed git credential helper
[ "$1" = get ] || exit 0

while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    protocol=*) protocol="${line#protocol=}" ;;
    host=*) host="${line#host=}" ;;
  esac
done
# only ever hand the GitHub token to GitHub, whatever remote this helper gets configured for
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0

token="${GITHUB_TOKEN:-$(fnox -c "$HOME/fnox.toml" get GITHUB_TOKEN 2>/dev/null)}"
[ -n "$token" ] || exit 0
printf 'username=x-access-token\n'
printf 'password=%s\n' "$token"
