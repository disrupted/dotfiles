{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "workspaceRoots": [
      "lua"
    ],
    "ignoreGlobs": [
      "**/*_spec.lua",
      "snippets/**",
      "lua/overseer/**",
      "overseer/strategy/jobstart_no_footer.lua",
      "overseer/component/edgy_size.lua",
      "overseer/component/shell_hook/interactive.lua",
      "overseer/template/python/poetry.lua",
      "overseer/template/python/uv.lua"
    ]
  },
  "format": {
    "externalTool": {
      "program": "stylua",
      "args": [
        "-",
        "--stdin-filepath",
        "${file}"
      ],
      "timeout": 2000
    },
    "externalToolRangeFormat": {
      "program": "stylua",
      "args": [
        "-",
        "--stdin-filepath",
        "${file}",
        "--range-start=${start_offset}",
        "--range-end=${end_offset}"
      ],
      "timeout": 2000
    }
  },
  "diagnostics": {
    "disable": [
      "unnecessary-if",
      "missing-fields"
    ]
  },
  "strict": {
    "typeCall": true,
    "arrayIndex": true
  }
}
