{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": true,
  "typescript": {
    "indentWidth": 2,
    "lineWidth": 80,
    "arguments.trailingCommas": "never",
    "parameters.trailingCommas": "never",
  },
  "json": {
    "indentWidth": 2,
    "associations": [
      "**/*.json",
      "**/*.jsonc",
      "**/*.avsc",
    ],
  },
  "yaml": {},
  "markdown": {},
  "toml": {
    "comment.forceLeadingSpace": false,
  },
  "dockerfile": {},
  // "css": {
  //     "indentWidth": 2,
  //     "lineWidth": 80,
  //     "useTabs": false
  // },
  "malva": {},
  "markup": {
    "associations": [
      "**/*.html",
      "**/*.vue",
      "**/*.svelte",
      "**/*.jinja2",
    ],
  },
  "graphql": {},
  "includes": [
    "**/*.{ts,tsx,js,jsx,cjs,mjs,json,jsonc,avsc,md,toml,css,html,vue,svelte,jinja2,yaml,yml,graphql,gql}",
    "dockerfile",
  ],
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/target",
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/dockerfile@0.7.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.5",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:dprint-plugin-graphql@0.2.3",
  ],
}
