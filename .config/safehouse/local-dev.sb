(deny file-read* file-write* (home-subpath "/.config/fnox/age.txt"))
(deny file-read* file-write* (workdir-literal "/.env"))

; mise
(allow file-read* (home-subpath "/.local/bin"))

(allow file-read* file-write*
    ; aube
    (home-subpath "/.local/share/aube")
    (home-subpath "/.cache/aube")

    ; hk
    (home-subpath "/Library/Caches/hk")

    ; dprint
    (home-subpath "/Library/Caches/dprint")
)

; Nx
(allow file-read* file-write* (home-subpath "/.nx"))
(allow network-bind network-outbound
    (remote unix-socket
        (path-regex #"^(/private)?/var/folders/[^/]+/[^/]+/T/plugin[-.0-9]+\.sock$")))
